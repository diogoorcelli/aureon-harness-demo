# Necessário apenas com --live. Sem chave, o projeto roda com o MockLLM.
OPENROUTER_API_KEY=

# Opcional: sobrescreva os modelos por temperatura do lead.
# Confira os slugs atuais em https://openrouter.ai/models
# MODEL_COLD=anthropic/claude-haiku-4.5
# MODEL_WARM=anthropic/claude-sonnet-4.5
# MODEL_HOT=anthropic/claude-opus-4.5

# --- Busca híbrida (v0.3). Tudo opcional: sem estas variáveis o projeto roda offline. ---
# O tenant decide se usa busca híbrida e reranking (campo "retrieval" no config.json).
# Aqui você escolhe a infraestrutura:
# RETRIEVAL_EMBEDDER=hash        # hash (offline) | cohere
# RETRIEVAL_RERANKER=lexical     # lexical (offline) | cohere
# RETRIEVAL_STORE=memory         # memory | pgvector (exige: pip install -r requirements-extras.txt)
# PGVECTOR_DSN=postgresql://postgres:postgres@localhost:5432/postgres
# COHERE_API_KEY=
# COHERE_EMBED_MODEL=embed-multilingual-v3.0   # confira os nomes atuais na documentação da Cohere
# COHERE_RERANK_MODEL=rerank-v3.5
